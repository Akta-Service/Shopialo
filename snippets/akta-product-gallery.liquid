<!-- Shopify Product Gallery using Swiper + product.media -->
<!-- Include Swiper CSS - LOCAL for faster loading -->
<link rel="preload" href="{{ 'swiper-bundle.min.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
<noscript><link rel="stylesheet" href="{{ 'swiper-bundle.min.css' | asset_url }}"></noscript>

<!-- Skeleton for product gallery -->
<div class="product-gallery-skeleton" id="gallery-skeleton" style="display: flex; gap: 1rem; padding: 20px;">
  <div class="skeleton skeleton-image" style="width: 80px; height: 400px; border-radius: 8px;"></div>
  <div class="skeleton skeleton-image" style="flex: 1; height: 400px; border-radius: 8px;"></div>
</div>

<style>
  .product-gallery {
    display: none; /* Hidden initially, shown by JavaScript */
    gap: 1rem;
  }

  /* Desktop: vertical thumbnails */
  .swiper-thumbs {
    width: 80px;
    flex: 0 0 auto;
    max-height: 550px;
    margin: 0 !important;
  }

  .swiper-thumbs .swiper-slide {
        width: 80px;
        height: 80px;
    }

  .swiper-thumbs .swiper-slide {
    opacity: 0.9;
    cursor: pointer;
  }
  .swiper-thumbs .swiper-slide-thumb-active {
    opacity: 1;
    border: 1.5px solid #818181;
    border-radius: 2px;
  }

  .swiper-main {
    width: 100%;
    max-width: 100%;
    max-height: 600px;
  }
   .swiper-thumbs .swiper-slide img {
    width: 100%;
    height: 100%;
    border-radius: 1px;
 }
.swiper-main .swiper-slide img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0px;
    max-height: 600px;
    object-fit: contain;
    {% comment %} background: #efefef; {% endcomment %}
}
 .swiper-thumbs .swiper-wrapper {
    width: 100%;    
}
.product-gallery {
    position: sticky;
    top: 85px;
}
.product--outer {   
    align-items: start;
}
.akta-nav-btn:after{
    display: none;
}
.akta-nav-btn {
    width: 40px;
    height: 40px;
    border: 1px solid #818181;
    border-radius: 3px;
    background: #fff;
    transition: 0.3s;
}
.akta-nav-btn svg {
    width: 25px;
    height: 25px;
    color: #000;
    transition: 0.3s;
}
.akta-nav-btn:hover{
    background: #000;
}
.akta-nav-btn:hover svg{
     color: #fff;
}

.swiper-thumbs .swiper-wrapper,
.swiper-main .swiper-wrapper{
    height: 100% !important;
    max-height: 600px !important;
}


  /* Mobile: thumbnails below */
  @media (max-width: 768px) {
    .product-gallery {
      flex-direction: column;
    }
    .swiper-thumbs {
      width: 100%;
      height: auto;
      order: 2;
    }
    .swiper-thumbs .swiper-wrapper {
      flex-direction: row;
    }
    .swiper-thumbs .swiper-slide {
        width: 80px;
        height: 80px;
    }
  }
  /* Mobile: thumbnails below */
  @media (max-width: 719px) {
    .product-gallery {
        position: static;
    }
    .swiper-main {
        width: 100%;
        max-width: 100%;
        max-height: 600px;
    }
  }
  @media (max-width: 600px) {
    .akta-nav-btn {
      width: 30px;
      height: 30px;      
    }
    .akta-nav-btn svg {
      width: 20px;
      height: 20px;      
    }
  }

{% comment %} quickview popup  {% endcomment %}
  .modal-content .product-gallery {
    display: flex !important;
    flex-direction: column-reverse;
    width: 100%;
    position: static;
    margin-bottom: 20px;
  }
  .modal-content article.product--outer {
    flex-direction: column;
  }
  .modal-content .swiper-main .swiper-wrapper {    
    max-height: 400px !important;
  }
  .modal-content .swiper-main .swiper-slide img {    
    max-height: 400px;
  }

  .modal-content .swiper-main .swiper-slide img {    
    border-radius: 10px;    
  }
  .modal-content .swiper-thumbs {
    width: 100%;    
    max-height: 82px;   
    display: none; 
  }
  @media (max-width: 768px) {
    .product-gallery {
        flex-direction: column !important;
    }
    .modal--quickshop-slim {      
      padding-top: 100px;
    }
    

  }
{% comment %} quickview popup end {% endcomment %}




</style>

<div class="product-gallery">

  <!-- Quick view image - optimized with responsive sizing -->
  <div class="quick-view-product-image">
    <img 
      src="{{ product.images[0] | image_url: width: 490, height: 734, crop: 'center' }}" 
      srcset="
        {{ product.images[0] | image_url: width: 245, height: 367, crop: 'center' }} 245w,
        {{ product.images[0] | image_url: width: 490, height: 734, crop: 'center' }} 490w,
        {{ product.images[0] | image_url: width: 735, height: 1101, crop: 'center' }} 735w
      "
      sizes="(max-width: 600px) 245px, 490px"
      width="490" 
      height="734" 
      alt="{{ product.title | escape }}"
      loading="eager"
      fetchpriority="high"
    >
  </div>






  <!-- Thumbnails -->
  <div class="swiper swiper-thumbs" id="thumbSwiper">
    <div class="swiper-wrapper">
      {% for media in product.media %}
        <div class="swiper-slide">
          {% if media.media_type == 'image' %}
            <img 
              src="{{ media | image_url: width: 80, height: 80, crop: 'center' }}" 
              srcset="
                {{ media | image_url: width: 80, height: 80, crop: 'center' }} 80w,
                {{ media | image_url: width: 160, height: 160, crop: 'center' }} 160w
              "
              sizes="80px"
              width="80" 
              height="80" 
              alt="{{ media.alt | default: product.title | escape }}"
              loading="lazy"
              class="thumb-img"
            >
          {% else %}
            {{ media | image_url: width: 80, height: 80, crop: 'center' | image_tag: class: 'thumb-img' }}
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>

  <!-- Main Images -->
  <div class="swiper swiper-main" id="mainSwiper">
    <div class="swiper-wrapper">
      {% for media in product.media %}
        <div class="swiper-slide">
          {% case media.media_type %}
            {% when 'image' %}
              <img 
                src="{{ media | image_url: width: 490, height: 734, crop: 'center' }}" 
                srcset="
                  {{ media | image_url: width: 245, height: 367, crop: 'center' }} 245w,
                  {{ media | image_url: width: 490, height: 734, crop: 'center' }} 490w,
                  {{ media | image_url: width: 735, height: 1101, crop: 'center' }} 735w,
                  {{ media | image_url: width: 980, height: 1468, crop: 'center' }} 980w
                "
                sizes="(max-width: 600px) 245px, (max-width: 900px) 490px, 735px"
                width="490" 
                height="734" 
                alt="{{ media.alt | default: product.title | escape }}"
                {% if forloop.first %}
                  loading="eager"
                  fetchpriority="high"
                {% else %}
                  loading="lazy"
                {% endif %}
              >
            {% when 'video' %}
              {{ media | video_tag: controls: true, image_size: '735x1101' }}
          {% endcase %}
        </div>
      {% endfor %}
    </div>
    <div class="swiper-button-prev akta-nav-btn">
      <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" height="200px" width="200px" xmlns="http://www.w3.org/2000/svg"><path fill="none" d="M0 0h24v24H0V0z"></path><path d="M15.41 16.59 10.83 12l4.58-4.59L14 6l-6 6 6 6 1.41-1.41z"></path></svg>
    </div>
    <div class="swiper-button-next akta-nav-btn">
      <svg stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 24 24" height="200px" width="200px" xmlns="http://www.w3.org/2000/svg"><path fill="none" d="M0 0h24v24H0V0z"></path><path d="M8.59 16.59 13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"></path></svg>
    </div>
  </div>
</div>

<script>
  // Hide skeleton and show gallery when loaded
  function showGallery() {
    var skeleton = document.getElementById('gallery-skeleton');
    var gallery = document.querySelector('.product-gallery');
    
    if (skeleton && gallery) {
      skeleton.style.display = 'none';
      gallery.style.display = 'flex';
    }
  }
  
  // Show gallery after images load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      setTimeout(showGallery, 1000);
    });
  } else {
    setTimeout(showGallery, 500);
  }
  
  // Fallback
  setTimeout(showGallery, 3000);
</script>
