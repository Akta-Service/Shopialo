{% if section.settings.show_product_recommendations %}
  {% assign product_limit = 5 %}

  <script
    type="application/json"
    data-section-type="static-product-recommendations"
    data-section-id="{{ section.id }}"
    data-section-data
    >
{
  "settings": {
    "limit": {{ product_limit }}
  },
    "productId": {{ product.id | json }},
    "sectionId": {{ section.id | json }}
}
  </script>

  <section
    class="product-section--container product-row--container product-recommendations--container below-fold"
    data-html
    data-product-recommendations
    >
    {% if recommendations.products_count > 0 %}
      <h2 class="product-section--title product-recommendations--title">
        {{ section.settings.product_recommendations_heading }}
      </h2>

    <!-- Skeleton loading for instant perceived performance -->
    <div class="product-section--content product-row skeleton-container" id="skeleton-{{ section.id }}" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 15px;">
      {% for i in (1..5) %}
        <div class="skeleton-card">
          <div class="skeleton skeleton-image" style="height: 250px; border-radius: 8px;"></div>
          <div style="padding: 15px;">
            <div class="skeleton skeleton-text" style="height: 16px; margin-bottom: 8px;"></div>
            <div class="skeleton skeleton-text short" style="height: 14px; margin-bottom: 12px;"></div>
            <div class="skeleton skeleton-text" style="height: 18px; margin-bottom: 12px;"></div>
            <div class="skeleton skeleton-text short" style="height: 20px; width: 120px;"></div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div
      class="product-section--content product-row"
      id="products-{{ section.id }}"
      style="display: none;"
      data-product-row
      >
      {% for product in recommendations.products limit: product_limit %}
        {%
          render 'product-grid-item',
          product: product,
        %}
      {% endfor %}
    </div>
    
    <script>
      // Hide skeleton and show products when loaded
      function showRecommendations() {
        console.log('showRecommendations called');
        var skeleton = document.getElementById('skeleton-{{ section.id }}');
        var products = document.getElementById('products-{{ section.id }}');
        
        console.log('skeleton:', skeleton);
        console.log('products:', products);
        
        if (skeleton && products) {
          console.log('Both elements found, switching visibility');
          skeleton.style.display = 'none';
          products.style.display = 'grid';
          products.style.visibility = 'visible';
          products.style.opacity = '1';
        } else {
          console.log('Elements not found');
        }
      }
      
      // Try multiple methods to ensure products show
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
          console.log('DOMContentLoaded fired');
          setTimeout(showRecommendations, 800);
        });
      } else {
        console.log('Document already loaded');
        setTimeout(showRecommendations, 500);
      }
      
      // Fallback - ensure products show after 2 seconds
      setTimeout(showRecommendations, 2000);
      
      // Force show after 3 seconds
      setTimeout(function() {
        var products = document.getElementById('products-{{ section.id }}');
        if (products) {
          products.style.display = 'grid';
          products.style.visibility = 'visible';
          products.style.opacity = '1';
        }
      }, 3000);
    </script>
    {% endif %}
  </section>

  {% render 'quick-shop' %}
{% endif %}

{% schema %}
{
  "name": "t:sections.product_recommendations.name",
  "class": "product-recommendations--section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_product_recommendations",
      "label": "t:sections.product_recommendations.show_product_recommendations.label",
      "info": "t:sections.product_recommendations.show_product_recommendations.info",
      "default": true
    },
    {
      "type": "text",
      "id": "product_recommendations_heading",
      "label": "t:sections.product_recommendations.product_recommendations_heading.label",
      "default": "You may also like"
    }
  ]
}
{% endschema %}