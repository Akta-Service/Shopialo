        if (!idleCallbackSupported) {
          window.requestIdleCallback = function(cb) {
            return setTimeout(function() {
              cb({ didTimeout: false, timeRemaining: function() { return 0; } });
            }, 1);
          };
        }
        
        // ULTRA-AGGRESSIVE: Block and defer ALL non-critical scripts
        function deferScript(script, delay, useIdle) {
          if (script.hasAttribute('data-deferred')) return;
          script.setAttribute('data-deferred', 'true');
          
          var src = script.src;
          var parent = script.parentNode;
          if (parent) parent.removeChild(script);
          
          var loadScript = function() {
            if (useIdle && idleCallbackSupported) {
              window.requestIdleCallback(function() {
                var newScript = document.createElement('script');
                newScript.src = src;
                newScript.async = true;
                document.body.appendChild(newScript);
              }, { timeout: delay });
            } else {
              setTimeout(function() {
                var newScript = document.createElement('script');
                newScript.src = src;
                newScript.async = true;
                document.body.appendChild(newScript);
