    {%- comment -%}CRITICAL: FastDOM-style layout thrashing prevention{%- endcomment -%}
    <script>
      // Prevent layout thrashing with read/write batching (reduces Style & Layout from 1,761ms)
      (function() {
        'use strict';
        
        // Batch queues for DOM operations
        var readQueue = [];
        var writeQueue = [];
        var rafScheduled = false;
        var measurementCache = new Map();
        var cacheValidUntil = 0;
        
        // Flush queues in correct order: reads first, then writes
        function flushQueues() {
          rafScheduled = false;
          
          // Execute all reads first (measurements)
          var reads = readQueue.slice();
          readQueue.length = 0;
          reads.forEach(function(task) {
            try {
              task();
            } catch (e) {
              console.warn('Read task error:', e);
            }
          });
          
          // Then execute all writes (style changes)
          var writes = writeQueue.slice();
          writeQueue.length = 0;
          writes.forEach(function(task) {
            try {
              task();
            } catch (e) {
              console.warn('Write task error:', e);
            }
          });
          
          // Invalidate cache after writes
          measurementCache.clear();
          cacheValidUntil = performance.now() + 16; // Cache valid for 1 frame
        }
        
        // Schedule RAF if not already scheduled
        function scheduleFlush() {
          if (!rafScheduled) {
            rafScheduled = true;
            requestAnimationFrame(flushQueues);
          }
        }
        
        // Public API: Queue a DOM read operation
        window.fastRead = function(callback) {
          readQueue.push(callback);
          scheduleFlush();
        };
        
        // Public API: Queue a DOM write operation
        window.fastWrite = function(callback) {
          writeQueue.push(callback);
          scheduleFlush();
        };
        
        // Public API: Get cached measurement or measure and cache
        window.measureOnce = function(element, property) {
          var now = performance.now();
          if (now > cacheValidUntil) {
            measurementCache.clear();
          }
          
          var key = element.tagName + element.className + property;
          if (measurementCache.has(key)) {
            return measurementCache.get(key);
          }
          
          var value;
          switch(property) {
            case 'offsetWidth': value = element.offsetWidth; break;
            case 'offsetHeight': value = element.offsetHeight; break;
            case 'offsetTop': value = element.offsetTop; break;
            case 'offsetLeft': value = element.offsetLeft; break;
            case 'scrollTop': value = element.scrollTop; break;
            case 'scrollHeight': value = element.scrollHeight; break;
            case 'clientWidth': value = element.clientWidth; break;
            case 'clientHeight': value = element.clientHeight; break;
            default: value = element.getBoundingClientRect();
          }
          
          measurementCache.set(key, value);
          return value;
        };
      })();
    </script>
    
    {%- comment -%}Aggressive main-thread optimization{%- endcomment -%}
    <script>
      // Reduce garbage collection pressure by object pooling
      (function() {
        'use strict';
        var isMobile = window.innerWidth <= 768;
        var originalSetTimeout = window.setTimeout;
        
        // Object pool to reduce GC pressure (reduces Garbage Collection from 217ms)
        window.objectPool = {
          arrays: [],
          objects: [],
          
          getArray: function() {
            return this.arrays.length > 0 ? this.arrays.pop() : [];
          },
          
          releaseArray: function(arr) {
            arr.length = 0;
            if (this.arrays.length < 50) {
              this.arrays.push(arr);
            }
          },
          
          getObject: function() {
            return this.objects.length > 0 ? this.objects.pop() : {};
          },
          
          releaseObject: function(obj) {
            for (var key in obj) {
              delete obj[key];
            }
            if (this.objects.length < 50) {
              this.objects.push(obj);
            }
          }
        };
        
        // Reduce script evaluation time by deferring non-critical code
        var deferredTasks = [];
        window.deferTask = function(task) {
          deferredTasks.push(task);
        };
        
        // Execute deferred tasks during idle time
        function executeDeferredTasks() {
          if (deferredTasks.length === 0) return;
          
          if ('requestIdleCallback' in window) {
            requestIdleCallback(function(deadline) {
              var maxTime = isMobile ? 5 : 10;
              var startTime = performance.now();
              
              while ((performance.now() - startTime) < maxTime && deferredTasks.length > 0) {
                var task = deferredTasks.shift();
                try {
                  task();
                } catch (e) {
                  console.warn('Deferred task error:', e);
                }
              }
              if (deferredTasks.length > 0) {
                executeDeferredTasks();
              }
            }, { timeout: isMobile ? 2000 : 1000 });
          } else {
            originalSetTimeout(function() {
              var task = deferredTasks.shift();
              if (task) task();
              if (deferredTasks.length > 0) executeDeferredTasks();
            }, isMobile ? 32 : 16);
          }
        }
        
        window.addEventListener('load', function() {
          originalSetTimeout(executeDeferredTasks, isMobile ? 300 : 100);
        });
      })();
    </script>

