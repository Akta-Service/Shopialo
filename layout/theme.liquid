    <script>
      // Split empire.js into smaller execution chunks using requestAnimationFrame
      (function() {
        'use strict';
        var isMobile = window.innerWidth <= 768;
        
        // Throttle requestAnimationFrame on mobile to reduce rendering work
        if (isMobile) {
          var rafThrottle = 50; // ~20fps on mobile instead of 60fps
          var lastRaf = 0;
          var originalRaf = window.requestAnimationFrame;
          
          window.requestAnimationFrame = function(callback) {
            var now = Date.now();
            if (now - lastRaf < rafThrottle) {
              return setTimeout(function() {
                lastRaf = Date.now();
                callback(lastRaf);
              }, rafThrottle);
            }
            lastRaf = now;
            return originalRaf(callback);
          };
        }
        
        // Mark body as loaded for CSS transitions
        window.addEventListener('load', function() {
          window.requestIdleCallback(function() {
            document.body.classList.add('loaded');
          }, { timeout: 1000 });
        });
      })();
        
        // Optimize long tasks by breaking them up
        if ('scheduler' in window && 'yield' in window.scheduler) {
          // Use modern scheduler API if available
          window.optimizeTask = async function(callback) {
            await scheduler.yield();
            callback();
          };
        } else {
          // Fallback to setTimeout
          window.optimizeTask = function(callback) {
            setTimeout(callback, 0);
          };
        }
      })();
    </script>
    
